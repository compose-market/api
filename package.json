{
  "name": "compose-market-api",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && esbuild index.ts --bundle --platform=node --target=node25 --format=cjs --outfile=dist/index.cjs --minify && npm run copy-data",
    "deploy": "npx tsx deploy.ts --fast",
    "deploy:full": "npm run build && npx tsx deploy.ts",
    "tests": "npx tsx --test tests/*.test.ts",
    "copy-data": "mkdir -p dist/data && cp -f inference/data/models.json inference/data/models_extended.json dist/data/ 2>/dev/null || echo 'Note: Some data files not found'",
    "sync-models": "cd inference/scripts && npx tsx sync-models.ts",
    "dev": "tsx index.ts",
    "metrics": "tsx metrics/cli.ts sync && tsx metrics/cli.ts snapshot"
  },
  "dependencies": {
    "@composio/core": "^0.13.1",
    "@filoz/synapse-core": "^0.7.0",
    "@filoz/synapse-sdk": "^1.0.1",
    "@google/genai": "^2.10.0",
    "@huggingface/inference": "^4.13.22",
    "@neondatabase/serverless": "^1.1.0",
    "@x402/core": "^2.17.0",
    "@x402/evm": "^2.17.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "filecoin-pin": "^1.1.1",
    "ioredis": "^5.11.1",
    "puppeteer": "^25.3.0",
    "viem": "^2.54.1",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/ws": "^8.18.1",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  }
}
